{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor", "hopToken", "secret", "port", "retries", "perTryTimeoutSeconds", "timeoutSeconds", "image", "router"],
  "definitions": {
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "properties": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atespace", "name"],
      "properties": {
        "atespace": { "$ref": "#/definitions/dnsLabel" },
        "name": { "$ref": "#/definitions/dnsLabel" }
      }
    },
    "hopToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,}$",
      "description": "The public value that the shim sends in X-Gitlab-Token to the actor. The pattern keeps it safe inside the Lua code."
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "$ref": "#/definitions/dnsLabel" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "port": { "$ref": "#/definitions/port" },
    "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "perTryTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "string",
      "pattern": "^([a-z0-9.-]+(:[0-9]+)?/)?[a-z0-9._-]+(/[a-z0-9._-]+)*(:[A-Za-z0-9._-]+)?@sha256:[a-f0-9]{64}$",
      "description": "The Envoy image, pinned by digest. A tag alone is rejected."
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "resources": { "type": "object" },
    "allowFrom": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyPeer" } },
    "ingressRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "The host name of the route. The consumer sets it."
        },
        "entryPoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tlsSecretName": { "type": "string" }
      }
    }
  }
}
