{
  "title": "CI jobs",
  "uid": "ci-jobs",
  "tags": ["ci"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Job queue time (p50 and p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(gitlab_runner_job_queue_duration_seconds_bucket[1h])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(gitlab_runner_job_queue_duration_seconds_bucket[1h])))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Job duration (p50 and p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(gitlab_runner_job_duration_seconds_bucket[1h])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(gitlab_runner_job_duration_seconds_bucket[1h])))" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Jobs running and waiting",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "running", "expr": "sum(gitlab_runner_jobs)" },
        { "refId": "B", "legendFormat": "waiting", "expr": "sum(gitlab_runner_job_queue_size)" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Jobs started per hour",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "jobs", "expr": "sum(increase(gitlab_runner_jobs_total[1h]))" },
        { "refId": "B", "legendFormat": "{{failure_type}}", "expr": "sum by (failure_type) (increase(gitlab_runner_worker_processing_failures_total[1h]))" }
      ]
    }
  ]
}
